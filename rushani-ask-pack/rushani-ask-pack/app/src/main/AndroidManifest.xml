<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml for Rushani Latin Keyboard Pack
    This is an AnySoftKeyboard (ASK) language/keyboard add-on pack.

    It does NOT contain a full keyboard IME — it only declares the
    keyboard layout resources that ASK will load as an add-on.

    To build: open in Android Studio, run "Build > Build APK".
    Min SDK: 16 (Android 4.1+), which covers all practical ASK users.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rushani.ask.latinpack"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="16"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_keyboard_rushani"
        android:allowBackup="true"
        android:supportsRtl="false">

        <!--
            ASK discovers keyboard packs by looking for activities that
            respond to the KEYBOARD_PACK_KEYBOARD_DOES_NOT_EXIST intent.
            This is the standard ASK add-on discovery mechanism.
        -->
        <activity
            android:name=".RushaniLatinPackStub"
            android:label="@string/app_name"
            android:exported="true">

            <!-- Declares this as an ASK keyboards pack -->
            <intent-filter>
                <action android:name="com.menny.android.anysoftkeyboard.KEYBOARD_PACK_KEYBOARD_DOES_NOT_EXIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- Keyboard layout provider — points ASK to the keyboards.xml -->
        <receiver
            android:name=".KeyboardsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.menny.android.anysoftkeyboard.KEYBOARDS" />
            </intent-filter>
            <meta-data
                android:name="com.menny.android.anysoftkeyboard.keyboards"
                android:resource="@xml/keyboards" />
        </receiver>

    </application>

</manifest>
